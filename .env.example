# Path to a Google Cloud service-account key (JSON). The service account's email
# must be added as an Owner of the Search Console property.
GOOGLE_SERVICE_ACCOUNT_PATH=./service-account.json

# Search Console property (URL-prefix form, trailing slash)
GSC_SITE_URL=https://example.com/
# Optional: override the hostname used by the URL allowlist (defaults to GSC_SITE_URL's host)
# SITE_HOST=example.com

# Shopify store domain, used for the primary sitemap (falls back to GSC_SITE_URL/sitemap.xml)
SHOPIFY_STORE=your-store.myshopify.com
SHOPIFY_BLOG_HANDLE=news

# Where state/CSV files live (defaults to current directory)
# STATE_DIR=./data
# CRAWLER_USER_AGENT=SEOIndexingBot/1.0
